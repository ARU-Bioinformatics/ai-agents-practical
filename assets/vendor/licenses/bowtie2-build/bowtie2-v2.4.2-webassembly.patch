@@ -240,6 +240,27 @@ FILE_FLAGS     := -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE
 DEBUG_DEFS     = -DCOMPILER_OPTIONS="\"$(DEBUG_FLAGS) $(CXXFLAGS)\""
 RELEASE_DEFS   = -DCOMPILER_OPTIONS="\"$(RELEASE_FLAGS) $(CXXFLAGS)\""
 
+# Compiling to WebAssembly with Emscripten (adapted from the biowasm recipe for Bowtie 2):
+ifeq (em++,$(shell basename $(CXX)))
+  BITS := 64
+  # No x86 -msse2 flag here: Bowtie 2's SSE2 code (sse_wrap.h includes emmintrin.h) is compiled
+  # to WebAssembly SIMD by Emscripten's own emmintrin.h, switched on by -msimd128 -msse2 below.
+  # (The next two flags are from the biowasm recipe, which used SIMDe; they have no effect here.)
+  SSE_FLAG :=
+  CXXFLAGS += -fopenmp-simd
+  CPPFLAGS += -Ithird_party/simde
+  # Remove "-g3" debug flag to reduce .wasm size
+  RELEASE_FLAGS := -O3 $(SSE_FLAG) -funroll-loops
+  # WebAssembly exceptions and WebAssembly SIMD
+  FILE_FLAGS += -fwasm-exceptions -msimd128 -msse2
+  # No memory-mapped files and no shared memory in a browser
+  BOWTIE_MM :=
+  BOWTIE_SHARED_MEM :=
+endif
+
+
+COMPILER_NOTE ?= $(shell $(CXX) -v 2>&1 | tail -1)
+
 BOWTIE2_BIN_LIST := bowtie2-build-s \
   bowtie2-build-l \
   bowtie2-align-s \
